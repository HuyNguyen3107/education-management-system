# Cấu hình Email
# Copy file này thành .env và điền thông tin thực của bạn

# Email Gmail của bạn
MAIL_USERNAME=your-email@gmail.com

# App Password từ Gmail (16 ký tự)
# Cách lấy:
# 1. Vào https://myaccount.google.com/security
# 2. Bật "2-Step Verification"
# 3. Tìm "App passwords" → Tạo mật khẩu ứng dụng mới
# 4. Copy 16 ký tự vào đây
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Database (nếu cần thay đổi)
DB_URL=jdbc:postgresql://localhost:5432/education_management_system
DB_USERNAME=postgres
DB_PASSWORD=28122003
